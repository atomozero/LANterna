# Build dell'app nativa Haiku (UI BeAPI). Da usare SU Haiku: richiede libbe e
# gli header di sistema. NON compila su Linux generico.
#
# DA VERIFICARE su Haiku reale:
#  - BColumnListView/BStringColumn: header in headers/private/interface,
#    implementazione attesa in libbe. Se il linker non li trova, su alcune
#    build serve la libreria privata libcolumnlistview.
#  - getifaddrs/getnameinfo: forniti da libroot/libnetwork (vedi note nel core).
#
# Alternativa idiomatica: il makefile-engine di Haiku
# (/system/develop/etc/makefile-engine). Qui si usa un Makefile semplice.

CXX      ?= g++
PRIVATE  := /system/develop/headers/private
BSD_HDR  := /boot/system/develop/headers/bsd
CXXFLAGS ?= -std=c++17 -Wall -O2 -Isrc -D_DEFAULT_SOURCE \
            -I$(PRIVATE)/interface -I$(PRIVATE)/shared -I$(BSD_HDR)
LIBS     := -lbe -lnetwork -lbsd -lcolumnlistview -lshared -ltracker
APP      := LANterna

CORE_SRCS := \
  src/net/Subnet.cpp \
  src/net/PortProbe.cpp \
  src/net/Resolver.cpp \
  src/net/ArpCache.cpp \
  src/model/DeviceStore.cpp \
  src/model/DevicePersistence.cpp \
  src/enrich/ReverseDnsEnricher.cpp \
  src/enrich/ArpMacEnricher.cpp \
  src/enrich/OuiDatabase.cpp \
  src/enrich/OuiVendorEnricher.cpp \
  src/enrich/TypeInferenceEnricher.cpp \
  src/scan/Scanner.cpp

UI_SRCS := \
  src/ui/ScanRunner.cpp \
  src/ui/MainWindow.cpp \
  src/ui/PivotWindow.cpp \
  src/ui/main_gui.cpp

SRCS := $(CORE_SRCS) $(UI_SRCS)
OBJS := $(SRCS:.cpp=.o)

all: $(APP)

$(APP): $(OBJS)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(LIBS)

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJS) $(APP)

.PHONY: all clean
