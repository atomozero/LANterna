# Build dell'app nativa Haiku (UI BeAPI). Da usare SU Haiku: richiede libbe e
# gli header di sistema. NON compila su Linux generico.
#
# DA VERIFICARE su Haiku reale:
#  - BColumnListView/BStringColumn: header in headers/private/interface,
#    implementazione attesa in libbe. Se il linker non li trova, su alcune
#    build serve la libreria privata libcolumnlistview.
#  - getifaddrs/getnameinfo: forniti da libroot/libnetwork (vedi note nel core).
#
# Alternativa idiomatica: il makefile-engine di Haiku
# (/system/develop/etc/makefile-engine). Qui si usa un Makefile semplice.

CXX      ?= g++
PRIVATE  := /system/develop/headers/private
BSD_HDR  := /boot/system/develop/headers/bsd
CXXFLAGS ?= -std=c++17 -Wall -O2 -Isrc -D_DEFAULT_SOURCE -MMD -MP \
            -I$(PRIVATE)/interface -I$(PRIVATE)/shared -I$(BSD_HDR)
LIBS     := -lbe -lnetwork -lbsd -lcolumnlistview -lshared -ltracker \
            -lbnetapi -lssl -lcrypto -llocalestub
APP      := LANterna

# Catalog (BCatalog / Haiku localization).
SIG      := x-vnd.atomozero-LANterna
LANGS    := it es de ja
LOCALE_DIR := locales
INSTALL_LOCALE_DIR := $(HOME)/config/non-packaged/data/locale/catalogs/$(SIG)
LANG_NAME_en := English
LANG_NAME_it := Italian
LANG_NAME_es := Spanish
LANG_NAME_de := German
LANG_NAME_ja := Japanese

CORE_SRCS := \
  src/net/Subnet.cpp \
  src/net/PortProbe.cpp \
  src/net/Resolver.cpp \
  src/net/ArpCache.cpp \
  src/net/WakeOnLan.cpp \
  src/net/BannerGrabber.cpp \
  src/net/TlsCertGrabber.cpp \
  src/net/DnsLookup.cpp \
  src/model/DeviceStore.cpp \
  src/model/DevicePersistence.cpp \
  src/model/DeviceHistory.cpp \
  src/enrich/ReverseDnsEnricher.cpp \
  src/enrich/ArpMacEnricher.cpp \
  src/enrich/OuiDatabase.cpp \
  src/enrich/OuiVendorEnricher.cpp \
  src/enrich/TypeInferenceEnricher.cpp \
  src/enrich/MdnsEnricher.cpp \
  src/enrich/NetBiosEnricher.cpp \
  src/enrich/SnmpEnricher.cpp \
  src/enrich/SsdpEnricher.cpp \
  src/scan/Scanner.cpp

UI_SRCS := \
  src/ui/ScanRunner.cpp \
  src/ui/HeaderView.cpp \
  src/ui/MainWindow.cpp \
  src/ui/PivotWindow.cpp \
  src/ui/PingWindow.cpp \
  src/ui/DeviceDetailsWindow.cpp \
  src/ui/HistoryWindow.cpp \
  src/ui/SettingsWindow.cpp \
  src/ui/TopologyView.cpp \
  src/ui/TracerouteWindow.cpp \
  src/ui/DnsLookupWindow.cpp \
  src/ui/WifiInfo.cpp \
  src/ui/NetworkReplicant.cpp \
  src/ui/main_gui.cpp

SRCS := $(CORE_SRCS) $(UI_SRCS)
OBJS := $(SRCS:.cpp=.o)
DEPS := $(SRCS:.cpp=.d)

RDEF := LANterna.rdef
RSRC := LANterna.rsrc

all: $(APP)

# Compila il .rdef nel .rsrc binario. Include l'icona vettoriale Beacon.hvif
# (vedi LANterna.rdef -> BEOS:ICON), la firma app e la versione.
$(RSRC): $(RDEF) Beacon.hvif
	rc -o $@ $(RDEF)

# Link finale + iniezione risorse + registrazione MIME. Senza i passaggi
# xres/mimeset Tracker mostra l'icona generica del binario invece di
# Beacon.hvif.
$(APP): $(OBJS) $(RSRC)
	$(CXX) $(CXXFLAGS) -o $@ $(OBJS) $(LIBS)
	xres -o $@ $(RSRC)
	mimeset -f $@

%.o: %.cpp
	$(CXX) $(CXXFLAGS) -c -o $@ $<

# ── Localization (BCatalog) ──────────────────────────────────────────
# `catkeys` rigenera locales/en.catkeys come "master" raccogliendo tutti i
# B_TRANSLATE / B_TRANSLATE_MARK dai sorgenti UI (vedi src/ui/Locale.h).
# collectcatkeys legge un file C++ gia' preprocessato (g++ -E con
# -DB_COLLECTING_CATKEYS) -- vedi /system/develop/etc/makefile-engine per
# il riferimento idiomatico.
# I file localizzati locales/<lang>.catkeys sono mantenuti a mano dai
# traduttori (o seedati una tantum da tools/extract_locale.py).
catkeys: $(UI_SRCS) src/ui/Locale.h
	mkdir -p $(LOCALE_DIR)
	@# -P sopprime i marker `# linenum file` del preprocessore, altrimenti
	@# si infilano dentro B_CATKEY((...)) e collectcatkeys non riconosce
	@# piu' il pattern.
	$(CXX) $(CXXFLAGS) -DB_COLLECTING_CATKEYS -E -P $(UI_SRCS) \
	    > $(LOCALE_DIR)/.preprocessed.cpp
	collectcatkeys -s $(SIG) -o $(LOCALE_DIR)/en.catkeys \
	    $(LOCALE_DIR)/.preprocessed.cpp
	rm -f $(LOCALE_DIR)/.preprocessed.cpp

# Compila ogni .catkeys nel .catalog binario consumato a runtime.
$(LOCALE_DIR)/%.catalog: $(LOCALE_DIR)/%.catkeys
	linkcatkeys -s $(SIG) -l $(LANG_NAME_$*) -o $@ $<

catalogs: $(patsubst %,$(LOCALE_DIR)/%.catalog,en $(LANGS))

# Installa i catalog dove BCatalog li cerca per default in dev.
install-catalogs: catalogs
	mkdir -p $(INSTALL_LOCALE_DIR)
	cp $(LOCALE_DIR)/*.catalog $(INSTALL_LOCALE_DIR)/

# ── HPKG packaging ───────────────────────────────────────────────────
# Costruisce lanterna-<ver>-x86_64.hpkg pronto per HaikuDepot / pkgman.
# Layout dentro il pkg (mappato da packagefs a `/boot/system/`):
#   apps/LANterna/LANterna                                          (binario)
#   data/LANterna/oui.txt                                           (DB OUI, se presente)
#   data/locale/catalogs/x-vnd.atomozero-LANterna/<lang>.catalog    (i18n)
#   documentation/packages/lanterna/README.md
#   .PackageInfo                                                    (metadati)
PKG_VER    := 1.0.0-1
PKG_NAME   := lanterna-$(PKG_VER)-x86_64.hpkg
PKG_STAGE  := build/pkg

hpkg: $(APP) catalogs PackageInfo
	rm -rf $(PKG_STAGE)
	mkdir -p $(PKG_STAGE)/apps/LANterna
	mkdir -p $(PKG_STAGE)/data/LANterna
	mkdir -p $(PKG_STAGE)/data/locale/catalogs/$(SIG)
	mkdir -p $(PKG_STAGE)/documentation/packages/lanterna
	cp $(APP) $(PKG_STAGE)/apps/LANterna/
	cp $(LOCALE_DIR)/*.catalog \
	    $(PKG_STAGE)/data/locale/catalogs/$(SIG)/
	cp README.md $(PKG_STAGE)/documentation/packages/lanterna/
	@# oui.txt e' opzionale: se presente accanto al Makefile lo includiamo,
	@# altrimenti si fa a meno (l'app cerca anche in ~/config/settings).
	@if [ -f oui.txt ]; then \
	    echo "cp oui.txt -> data/LANterna/"; \
	    cp oui.txt $(PKG_STAGE)/data/LANterna/; \
	else \
	    echo "[warn] oui.txt non presente nel repo, non incluso nel pkg."; \
	fi
	package create -C $(PKG_STAGE) -i PackageInfo $(PKG_NAME)
	@echo ""
	@echo "hpkg pronto: $(PKG_NAME)"
	@echo "  Install:     pkgman install ./$(PKG_NAME)"
	@echo "  Ispezione:   package dump ./$(PKG_NAME) | head"

clean:
	rm -f $(OBJS) $(DEPS) $(APP) $(RSRC) $(LOCALE_DIR)/*.catalog
	rm -rf $(PKG_STAGE)
	rm -f lanterna-*-x86_64.hpkg

-include $(DEPS)

.PHONY: all clean catkeys catalogs install-catalogs hpkg
